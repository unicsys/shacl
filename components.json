# see how many tables are in each database
for db in spark.sql("SHOW DATABASES").collect():
    count = spark.sql(f"SHOW TABLES IN {db.databaseName}").count()
    print(f"{db.databaseName}: {count} tables")


# Next python notebook cell
# List tables in each database
databases = spark.sql("SHOW DATABASES").collect()
for db in databases:
    print(f"Database name: {db.databaseName}")
    spark.sql(f"SHOW TABLES IN {db.databaseName}").show(2000, truncate=False)


# Next python notebook cell
# List row count and data in selected tables 
# Format: ["database_name.table_name", "another_database.another_table"]
tables_to_explore = ["information_schema.column_tags", "information_schema.parameters"]

# 2. Loop through your selected tables to get row counts and a data preview
for table_name in tables_to_explore:
    print(f"Table name: {table_name} ---")

    # Get and print the total row count
    try:
        row_count = spark.table(table_name).count()
        print(f"Row Count: {row_count}")

        # Show the first 10 rows of data
        print("Data Preview:")
        spark.table(table_name).show(10, truncate=False)
        print("\n") # Add a newline for better separation

    except Exception as e:
        print(f"Could not process table {table_name}. Error: {e}\n")

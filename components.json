schemas_to_ignore = ['system', 'default']

try:
    databases_df = spark.sql("SHOW DATABASES")
    database_names = [row.databaseName for row in databases_df.collect() if row.databaseName not in schemas_to_ignore]
except Exception as e:
    print(f"{e}")
    database_names = []

if not database_names:
    print("No user-defined databases found")
else:
    print(f"Found the following databases: {', '.join(database_names)}\n")

for db_name in database_names:
    print(f"Database/Schema: {db_name}")
    
    try:
        tables_df = spark.sql(f"SHOW TABLES IN {db_name}")
        table_names = [row.tableName for row in tables_df.collect()]
    except Exception as e:
        print(f"  -  database '{db_name}'. Error: {e}\n")
        continue 

    if not table_names:
        print("  - No tables in database.\n")
        continue

    for table_name in table_names:
        print(f"  Table: {table_name}")
        
        try:
            columns_df = spark.sql(f"DESCRIBE TABLE {db_name}.{table_name}")

            for row in columns_df.collect():
                if row.col_name and not row.col_name.startswith('#'):
                    print(f"    - Column: {row.col_name:<40} Data Type: {row.data_type}")
        
        except Exception as e:
            print(f"    - table {table_name}. Error: {e}")
        
        print("") 

    print(""+ "\n")

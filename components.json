# For each table, convert everything to string and search
for table in ["table1", "table2", "table3"]:  # Replace with your table names
    try:
        count = spark.sql(f"""
        SELECT COUNT(*) as matches
        FROM {table}
        WHERE lower(concat_ws('|', *)) LIKE '%coating%' 
           OR lower(concat_ws('|', *)) LIKE '%loss%'
        """).collect()[0]['matches']
        
        if count > 0:
            print(f"Found {count} matches in {table}")
    except:
        pass

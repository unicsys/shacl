# Run this in a Jupyter cell to check your environment
import sys
import os

print("Python Version:", sys.version)
print("Python Location:", sys.executable)
print("\nCurrent Working Directory:", os.getcwd())
print("\nUser Home Directory:", os.path.expanduser("~"))

# Check if Java is available
import subprocess
try:
    result = subprocess.run(['java', '-version'], capture_output=True, text=True)
    print("\n✓ Java is installed:")
    print(result.stderr)  # Java prints version to stderr
except FileNotFoundError:
    print("\n❌ Java not found - we'll need to work around this")

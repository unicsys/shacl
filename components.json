# ============================
# 2. Helper: format conversation
# ============================

def build_input_ids_from_history(chat_history):
    """
    chat_history: list of {"role": "user"|"assistant"|"system", "content": "..."}
    returns: input_ids tensor on model device
    """
    # If the tokenizer supports chat templates (Gemma does), use it
    if hasattr(tokenizer, "apply_chat_template"):
        input_ids = tokenizer.apply_chat_template(
            chat_history,
            tokenize=True,
            add_generation_prompt=True,
            return_tensors="pt"
        ).to(model.device)
    else:
        # Fallback: simple concatenation of messages
        prompt = ""
        for m in chat_history:
            role = m["role"].upper()
            prompt += f"{role}: {m['content']}\n"
        prompt += "ASSISTANT: "
        input_ids = tokenizer(prompt, return_tensors="pt").input_ids.to(model.device)

    return input_ids

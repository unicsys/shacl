import pandas as pd
from itertools import combinations

def find_primary_key(csv_path, max_combo=3):
    print(f"Analyzing {csv_path} for unique keys...")
    df = pd.read_csv(csv_path, low_memory=False)
    rows = len(df)
    cols = df.columns.tolist()
    
    # 1. Check Single Columns
    for col in cols:
        if df[col].nunique() == rows:
            return [col] # Found a single ID column!

    # 2. Check Combinations (Pairs, Triplets)
    # We prioritize columns that look like IDs (contain 'ID', 'Num', 'Code', 'Serial')
    # to speed up the search, but strictly we should check all.
    for i in range(2, max_combo + 1):
        print(f"Checking combinations of {i} columns...")
        for combo in combinations(cols, i):
            # Fast check: Create a composite key
            is_unique = df.groupby(list(combo)).ngroups == rows
            if is_unique:
                return list(combo) # Found a composite key!
                
    return None # No unique key found

# --- Usage ---
key = find_primary_key("input/sample_data.csv")

if key:
    print(f"✅ FOUND ROW ID: {key}")
    # You can now programmatically set this in your config
else:
    print("❌ NO NATURAL KEY FOUND. Use Strategy 2 or 3.")

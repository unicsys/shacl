import urllib.request
import ssl
import pandas as pd
import io
import os
import sys

# --- CONFIGURATION ---
LOCATION_NAME = "Los Angeles"
LATITUDE = 34.0549
LONGITUDE = -118.2426
START_DATE = "2023-01-01"
END_DATE = "2023-01-31"

def get_weather_bare_metal():
    # 1. Clean Environment Variables
    # Sometimes old proxy settings get stuck in memory. We remove them for this run.
    for k in list(os.environ.keys()):
        if "proxy" in k.lower():
            try:
                del os.environ[k]
            except:
                pass

    # 2. Setup the URL for CSV format
    base_url = "https://archive-api.open-meteo.com/v1/archive"
    
    variables = [
        "temperature_2m", "relative_humidity_2m", "dew_point_2m", "apparent_temperature",
        "precipitation", "rain", "snowfall", "snow_depth", "weather_code",
        "pressure_msl", "surface_pressure", "cloud_cover", "cloud_cover_low",
        "et0_fao_evapotranspiration", "vapor_pressure_deficit", "wind_speed_10m",
        "wind_direction_10m", "wind_gusts_10m", "soil_temperature_0_to_7cm",
        "soil_moisture_0_to_7cm", "shortwave_radiation", "direct_radiation",
        "diffuse_radiation", "direct_normal_irradiance"
    ]
    
    hourly_string = ",".join(variables)
    
    # Construct the full URL manually
    full_url = (
        f"{base_url}?latitude={LATITUDE}&longitude={LONGITUDE}"
        f"&start_date={START_DATE}&end_date={END_DATE}"
        f"&hourly={hourly_string}&timezone=auto&format=csv"
    )

    print(f"Target URL constructed for {LOCATION_NAME}...")

    # 3. Create a 'No-Check' SSL Context
    # This is the standard library way to say "verify=False"
    try:
        ctx = ssl._create_unverified_context()
    except AttributeError:
        # Fallback for older Pythons
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE

    # 4. Force 'No Proxy' Configuration
    # We create an 'opener' that explicitly uses empty proxy settings
    proxy_handler = urllib.request.ProxyHandler({})
    opener = urllib.request.build_opener(proxy_handler, urllib.request.HTTPSHandler(context=ctx))
    urllib.request.install_opener(opener)

    # 5. Download Data
    print("Attempting download using Standard Library (urllib)...")
    try:
        # Fake a browser user-agent
        req = urllib.request.Request(
            full_url, 
            headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"}
        )
        
        with urllib.request.urlopen(req, timeout=30) as response:
            print("Connection Established! Reading data...")
            data_bytes = response.read()
            
            # 6. Load into Pandas
            # We wrap the bytes in a buffer so pandas treats it like a file
            df = pd.read_csv(io.BytesIO(data_bytes), skiprows=3)
            return df

    except urllib.request.HTTPError as e:
        print(f"\nHTTP ERROR: {e.code} - {e.reason}")
    except urllib.request.URLError as e:
        print(f"\nURL ERROR: {e.reason}")
    except Exception as e:
        import traceback
        print("\n--- CRITICAL ERROR ---")
        traceback.print_exc()
        
    return None

# --- EXECUTION ---
df = get_weather_bare_metal()

if df is not None:
    filename = "comprehensive_environment_data.csv"
    df.to_csv(filename, index=False)
    print(f"\nSUCCESS: Saved {len(df)} rows to '{filename}'.")
    # Show first few columns to verify
    print(f"Columns Retrieved: {list(df.columns)[:5]} ...")

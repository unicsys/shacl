import requests
import pandas as pd
import io
import urllib3
import os

# --- CONFIGURATION ---
LOCATION_NAME = "Los Angeles"
LATITUDE = 34.0549
LONGITUDE = -118.2426
START_DATE = "2023-01-01"
END_DATE = "2023-01-31"

# --- NETWORK FIXES ---
# 1. Disable SSL Warnings
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

# 2. Force Python to ignore any "Ghost" Proxies in your environment variables
# (Sometimes old settings get stuck here and break things)
os.environ.pop('HTTP_PROXY', None)
os.environ.pop('HTTPS_PROXY', None)
os.environ.pop('http_proxy', None)
os.environ.pop('https_proxy', None)

def get_weather_manual():
    # We ask for CSV format directly from the API to skip processing steps
    base_url = "https://archive-api.open-meteo.com/v1/archive"
    
    # All the variables you wanted
    variables = [
        "temperature_2m", "relative_humidity_2m", "dew_point_2m", "apparent_temperature",
        "precipitation", "rain", "snowfall", "snow_depth", "weather_code",
        "pressure_msl", "surface_pressure", "cloud_cover", "cloud_cover_low",
        "et0_fao_evapotranspiration", "vapor_pressure_deficit", "wind_speed_10m",
        "wind_direction_10m", "wind_gusts_10m", "soil_temperature_0_to_7cm",
        "soil_moisture_0_to_7cm", "shortwave_radiation", "direct_radiation",
        "diffuse_radiation", "direct_normal_irradiance"
    ]
    
    # Join variables with comma for the URL
    hourly_string = ",".join(variables)

    params = {
        "latitude": LATITUDE,
        "longitude": LONGITUDE,
        "start_date": START_DATE,
        "end_date": END_DATE,
        "hourly": hourly_string,
        "timezone": "auto",
        "format": "csv" # <--- Request CSV directly
    }

    headers = {
        # Mimic Chrome exactly
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.5",
        "Connection": "keep-alive"
    }

    print(f"Attempting connection to Open-Meteo for {LOCATION_NAME}...")
    
    try:
        # verify=False disables the SSL check that your firewall is blocking
        response = requests.get(base_url, params=params, headers=headers, verify=False, timeout=20)
        
        # Check if successful
        response.raise_for_status()
        
        print("Connection Successful! Downloading data...")
        
        # Read the CSV data directly into Pandas
        # Skip the first 3 rows because Open-Meteo CSVs have header metadata lines
        df = pd.read_csv(io.BytesIO(response.content), skiprows=3)
        
        return df

    except requests.exceptions.SSLError as e:
        print("\n--- SSL ERROR ---")
        print("The firewall is still blocking the certificate.")
        print(e)
    except requests.exceptions.ConnectionError as e:
        print("\n--- CONNECTION ERROR ---")
        print("Python cannot reach the internet.")
        print(e)
    except Exception as e:
        print("\n--- GENERAL ERROR ---")
        print(e)
    return None

# --- EXECUTION ---
df = get_weather_manual()

if df is not None:
    filename = "comprehensive_environment_data.csv"
    df.to_csv(filename, index=False)
    print(f"\nSUCCESS: Saved {len(df)} rows to '{filename}'.")
    print(f"Columns: {list(df.columns)}")

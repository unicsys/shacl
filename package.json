                                                                                                                                        ]
                                                                                                                                      ) ;
                                                                                                                   rdf:type owl:Class
                                                                                                                 ] ;
                                                                                             rdfs:subClassOf <https://spec.industrialontologies.org/ontology/core/Core/InformationContentEntity> ;

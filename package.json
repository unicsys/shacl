import csv
import uuid
import hashlib
from datetime import datetime
from pathlib import Path
from rdflib import Graph, Namespace, Literal, URIRef, RDF, RDFS, OWL, DCTERMS, PROV
from rdflib.namespace import XSD
import re
import json

# Define namespaces
AAFO = Namespace("https://ontologyhub.rtx.com/RTXEnterpriseOntologies/AerospaceAbbreviationandFull-formOntology/")
IOF = Namespace("https://spec.industrialontologies.org/ontology/core/Core/")
BFO = Namespace("http://purl.obolibrary.org/obo/")

class AbbreviationKnowledgeGraphManager:
    """
    Industrial-grade manager for abbreviation knowledge graph with provenance tracking
    """
    
    def __init__(self, ontology_path, knowledge_graph_path=None, config_path="kg_config.json"):
        """
        Initialize the knowledge graph manager
        
        Args:
            ontology_path: Path to the base ontology TTL file
            knowledge_graph_path: Path to existing knowledge graph (if any)
            config_path: Path to configuration file for tracking sources
        """
        self.ontology_path = Path(ontology_path)
        self.kg_path = Path(knowledge_graph_path) if knowledge_graph_path else None
        self.config_path = Path(config_path)
        
        # Load or initialize configuration
        self.config = self._load_config()
        
        # Initialize or load the graph
        self.graph = self._initialize_graph()
        
        # Track processed sources
        self.processed_sources = set(self.config.get('processed_sources', []))
        
    def _load_config(self):
        """Load configuration file if it exists"""
        if self.config_path.exists():
            with open(self.config_path, 'r') as f:
                return json.load(f)
        return {
            'processed_sources': [],
            'source_metadata': {},
            'last_update': None
        }
    
    def _save_config(self):
        """Save configuration to file"""
        self.config['processed_sources'] = list(self.processed_sources)
        self.config['last_update'] = datetime.now().isoformat()
        with open(self.config_path, 'w') as f:
            json.dump(self.config, f, indent=2)
    
    def _initialize_graph(self):
        """Initialize the RDF graph with base ontology"""
        g = Graph()
        
        # Load base ontology
        if self.ontology_path.exists():
            print(f"Loading ontology from {self.ontology_path}")
            g.parse(self.ontology_path, format='turtle')
        else:
            print(f"Warning: Ontology file {self.ontology_path} not found")
        
        # Load existing knowledge graph if provided
        if self.kg_path and self.kg_path.exists():
            print(f"Loading existing knowledge graph from {self.kg_path}")
            g.parse(self.kg_path, format='turtle')
        
        # Bind namespaces
        g.bind("aafo", AAFO)
        g.bind("iof", IOF)
        g.bind("bfo", BFO)
        g.bind("dcterms", DCTERMS)
        g.bind("prov", PROV)
        
        return g
    
    def generate_deterministic_id(self, text, prefix=""):
        """Generate deterministic ID based on text content"""
        # Create hash of the text for consistency
        hash_obj = hashlib.md5(text.encode())
        hash_hex = hash_obj.hexdigest()[:8]
        clean_text = re.sub(r'[^a-zA-Z0-9]', '', text)[:20]
        return f"{prefix}_{clean_text}_{hash_hex}"
    
    def generate_random_id(self, prefix=""):
        """Generate random UUID-based ID"""
        return f"{prefix}_{uuid.uuid4().hex[:8]}"
    
    def create_source_provenance(self, csv_file_path, source_name=None):
        """
        Create provenance information for a data source
        
        Args:
            csv_file_path: Path to CSV file
            source_name: Optional custom name for the source
        
        Returns:
            URIRef for the source entity
        """
        file_path = Path(csv_file_path)
        source_name = source_name or file_path.stem
        
        # Create source entity
        source_id = self.generate_deterministic_id(source_name, "Source")
        source_uri = URIRef(AAFO + source_id)
        
        # Add source metadata
        self.graph.add((source_uri, RDF.type, PROV.Entity))
        self.graph.add((source_uri, RDFS.label, Literal(f"Data Source: {source_name}")))
        self.graph.add((source_uri, DCTERMS.source, Literal(str(file_path.absolute()))))
        self.graph.add((source_uri, DCTERMS.created, Literal(datetime.now(), datatype=XSD.dateTime)))
        self.graph.add((source_uri, DCTERMS.format, Literal("CSV")))
        
        # Store in config
        self.config['source_metadata'][source_name] = {
            'file_path': str(file_path.absolute()),
            'processed_at': datetime.now().isoformat(),
            'uri': str(source_uri)
        }
        
        return source_uri
    
    def process_csv(self, csv_file_path, source_name=None, use_random_ids=False):
        """
        Process a CSV file and add to knowledge graph with provenance
        
        Args:
            csv_file_path: Path to CSV file
            source_name: Custom name for this source (defaults to filename)
            use_random_ids: If True, use random UUIDs; if False, use deterministic IDs
        
        Returns:
            Number of abbreviations processed
        """
        file_path = Path(csv_file_path)
        source_name = source_name or file_path.stem
        
        # Check if already processed
        source_hash = hashlib.md5(f"{file_path.absolute()}_{source_name}".encode()).hexdigest()
        if source_hash in self.processed_sources:
            print(f"Source {source_name} already processed. Skipping...")
            return 0
        
        # Create source provenance
        source_uri = self.create_source_provenance(csv_file_path, source_name)
        
        count = 0
        with open(csv_file_path, 'r', encoding='utf-8-sig') as file:
            reader = csv.DictReader(file)
            
            for row in reader:
                short_form_text = row['ShortForm'].strip()
                long_form_text = row['FullForm'].strip()
                
                # Generate IDs based on preference
                if use_random_ids:
                    sf_id = self.generate_random_id("SF")
                    lf_id = self.generate_random_id("LF")
                else:
                    sf_id = self.generate_deterministic_id(short_form_text, "SF")
                    lf_id = self.generate_deterministic_id(long_form_text, "LF")
                
                # IBE IDs always include source name for traceability
                ibe_sf_id = f"IBE_{source_name}_{sf_id}"
                ibe_lf_id = f"IBE_{source_name}_{lf_id}"
                
                # Create URIs
                shortform_ice = URIRef(AAFO + sf_id)
                longform_ice = URIRef(AAFO + lf_id)
                shortform_ibe = URIRef(AAFO + ibe_sf_id)
                longform_ibe = URIRef(AAFO + ibe_lf_id)
                
                # Check if abbreviation already exists (avoid duplicates)
                if (shortform_ice, RDF.type, AAFO.ShortForm) not in self.graph:
                    # Add type assertions
                    self.graph.add((shortform_ice, RDF.type, AAFO.ShortForm))
                    self.graph.add((longform_ice, RDF.type, AAFO.LongForm))
                    self.graph.add((shortform_ibe, RDF.type, AAFO.InformationBearingEntity))
                    self.graph.add((longform_ibe, RDF.type, AAFO.InformationBearingEntity))
                    
                    # Add labels
                    self.graph.add((shortform_ice, RDFS.label, Literal(f"SF: {short_form_text}")))
                    self.graph.add((longform_ice, RDFS.label, Literal(f"LF: {long_form_text}")))
                    
                    # Add relationships
                    self.graph.add((shortform_ice, AAFO.expandsTo, longform_ice))
                    self.graph.add((longform_ice, AAFO.abbreviatedAs, shortform_ice))
                    
                    # Generic dependence
                    self.graph.add((shortform_ice, BFO.BFO_0000084, shortform_ibe))
                    self.graph.add((longform_ice, BFO.BFO_0000084, longform_ibe))
                    
                    # Text values
                    self.graph.add((shortform_ibe, AAFO.hastextvalue, Literal(short_form_text, datatype=XSD.string)))
                    self.graph.add((longform_ibe, AAFO.hastextvalue, Literal(long_form_text, datatype=XSD.string)))
                    
                    # Link IBEs to source for provenance
                    self.graph.add((shortform_ibe, PROV.wasDerivedFrom, source_uri))
                    self.graph.add((longform_ibe, PROV.wasDerivedFrom, source_uri))
                    
                    count += 1
                else:
                    print(f"Abbreviation {short_form_text} already exists, skipping...")
        
        # Mark source as processed
        self.processed_sources.add(source_hash)
        self._save_config()
        
        print(f"Processed {count} new abbreviations from {source_name}")
        return count
    
    def save_knowledge_graph(self, output_path=None, format='turtle'):
        """
        Save the current state of the knowledge graph
        
        Args:
            output_path: Path to save the graph (defaults to kg_path)
            format: RDF serialization format
        """
        output_path = output_path or self.kg_path or Path("knowledge_graph.ttl")
        self.graph.serialize(destination=output_path, format=format)
        print(f"Knowledge graph saved to {output_path}")
        
        # Update config
        self.kg_path = Path(output_path)
        self._save_config()
    
    def get_statistics(self):
        """Get statistics about the knowledge graph"""
        stats = {
            'total_triples': len(self.graph),
            'short_forms': len(list(self.graph.subjects(RDF.type, AAFO.ShortForm))),
            'long_forms': len(list(self.graph.subjects(RDF.type, AAFO.LongForm))),
            'ibes': len(list(self.graph.subjects(RDF.type, AAFO.InformationBearingEntity))),
            'sources': len(self.processed_sources),
            'last_update': self.config.get('last_update', 'Never')
        }
        return stats
    
    def query_abbreviation(self, abbreviation):
        """Query for a specific abbreviation"""
        query = f"""
        PREFIX aafo: <{AAFO}>
        PREFIX bfo: <{BFO}>
        PREFIX prov: <http://www.w3.org/ns/prov#>
        
        SELECT ?longtext ?source
        WHERE {{
            ?ibe_short aafo:hastextvalue "{abbreviation}" .
            ?shortform bfo:BFO_0000084 ?ibe_short .
            ?shortform aafo:expandsTo ?longform .
            ?longform bfo:BFO_0000084 ?ibe_long .
            ?ibe_long aafo:hastextvalue ?longtext .
            OPTIONAL {{ ?ibe_short prov:wasDerivedFrom ?source }}
        }}
        """
        
        results = self.graph.query(query)
        return list(results)

# Example usage
if __name__ == "__main__":
    # Initialize the knowledge graph manager
    kg_manager = AbbreviationKnowledgeGraphManager(
        ontology_path="path/to/your/ontology.ttl",
        knowledge_graph_path="path/to/existing/kg.ttl"  # Optional, for incremental updates
    )
    
    # Process first CSV file
    kg_manager.process_csv(
        csv_file_path="abbreviations_batch1.csv",
        source_name="ATA_100_Spec",
        use_random_ids=False  # Use deterministic IDs
    )
    
    # Process second CSV file from different source
    kg_manager.process_csv(
        csv_file_path="abbreviations_batch2.csv",
        source_name="CFM56_Manual",
        use_random_ids=True  # Use random IDs for this batch
    )
    
    # Save the updated knowledge graph
    kg_manager.save_knowledge_graph("aerospace_kg.ttl")
    
    # Print statistics
    stats = kg_manager.get_statistics()
    print("\n=== Knowledge Graph Statistics ===")
    for key, value in stats.items():
        print(f"{key}: {value}")
    
    # Query example
    results = kg_manager.query_abbreviation("TEC")
    for result in results:
        print(f"TEC expands to: {result.longtext}")

# %%
# --- Find tables with ENG_ID and any DATE column ---

# This query first finds all tables that contain 'ENG_ID'.
# It then uses that list to select 'ENG_ID' and any 'DATE' type
# columns from only those tables.

find_eng_id_and_dates_query = """
WITH tables_with_eng_id AS (
    -- Step 1: Create a temporary list of all tables that have an 'ENG_ID' column.
    SELECT DISTINCT table_name
    FROM information_schema.columns
    WHERE table_schema = 'HAMR' AND column_name = 'ENG_ID'
)
-- Step 2: From that list of tables, select the ENG_ID column and all DATE columns.
SELECT
    c.table_name,
    c.column_name
FROM
    information_schema.columns c
JOIN
    tables_with_eng_id t ON c.table_name = t.table_name -- Only look in the tables found in Step 1
WHERE
    c.table_schema = 'HAMR'
    AND (c.column_name = 'ENG_ID' OR c.data_type = 'DATE') -- Filter for the columns we care about
ORDER BY
    c.table_name, c.column_name;
"""

print("--- Finding tables linking ENG_ID to dates ---")
linked_columns_df = analyzer.analyze(find_eng_id_and_dates_query)

print("\nRaw query result:")
display(linked_columns_df)

# %%
# --- Visualize the results in a more readable format ---

# We use pandas to group the results from the last query by table name.
# This gathers all the relevant columns for each table into a list.

if linked_columns_df is not None and not linked_columns_df.empty:
    # Group by table_name and aggregate the column_names into a list
    grouped_df = linked_columns_df.groupby('table_name')['column_name'].apply(list).reset_index()

    print("--- Analysis Results: Tables and Their Relevant Columns ---")

    # Loop through the grouped data and print it in a friendly format
    for index, row in grouped_df.iterrows():
        table = row['table_name']
        columns = row['column_name']
        
        # Separate the ENG_ID from the date columns for clarity
        eng_id_col = "ENG_ID"
        date_cols = [col for col in columns if col != 'ENG_ID']
        
        print(f"\n✅ Table: {table}")
        print(f"   • Key Column: {eng_id_col}")
        
        if date_cols:
            print(f"   • Date Columns Found ({len(date_cols)}):")
            for date_col in date_cols:
                print(f"     - {date_col}")
        else:
            # This case shouldn't happen with our query, but it's good practice
            print("   • No date columns found in this table.")
            
else:
    print("No tables found matching the criteria.")


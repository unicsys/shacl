                                                                                                                                                                                                         )
                                                                                                                                                                                           ]
                                                                                                                                                                                           [ rdf:type owl:Restriction ;
                                                                                                                                                                                             owl:onProperty <https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/agentIn> ;

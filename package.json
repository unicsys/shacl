
# --- Now, process and display the results based on a condition ---

if common_columns_df is not None and not common_columns_df.empty:

    # --- THIS IS THE KEY CHANGE ---
    # Instead of taking the top N, we filter the DataFrame to get all
    # rows where the 'table_count' is 2 or greater.
    filtered_df = common_columns_df[common_columns_df['table_count'] >= 2]
    
    print(f"\n--- Columns Appearing in 2 or More Tables ({len(filtered_df)} found) ---")

    if not filtered_df.empty:
        # Loop through the FILTERED DataFrame
        for index, row in filtered_df.iterrows():
            # We can still use the index for ranking if we want
            rank = index + 1
            column = row['column_name']
            count = row['table_count']
            table_list = row['tables']

            print(f"\nColumn: '{column}' (Found in {count} tables)")
            print("   • Tables:")
            for table in table_list:
                print(f"     - {table}")
    else:
        print("\nNo columns were found that appear in 2 or more tables.")

else:
    print("\nCould not analyze column frequency.")

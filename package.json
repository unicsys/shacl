# --- Find all tables that have a 'JCN' column ---

# This is a simple and direct query on the information schema.
find_jcn_query = """
SELECT
    table_name,
    column_name
FROM
    information_schema.columns
WHERE
    table_schema = 'HAMR' AND column_name = 'JCN'
ORDER BY
    table_name;
"""

print("--- Finding all tables with column 'JCN' ---")
jcn_tables_df = analyzer.analyze(find_jcn_query)

# Display the results directly. Since the result is simple,
# extra formatting isn't as necessary, but we can add it for clarity.

if jcn_tables_df is not None and not jcn_tables_df.empty:
    print("\n✅ Found 'JCN' column in the following tables:")
    display(jcn_tables_df)
else:
    print("\n❌ No tables were found containing a 'JCN' column.")



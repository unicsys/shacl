                                                                                                                                                                                                                           rdf:type owl:Class
                                                                                                                                                                                                                         ]
                                                                                                                                                                                                    ]
                                                                                                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                                                                                                      owl:onProperty <https://spec.industrialontologies.org/ontology/core/Core/temporallyStarts> ;

label_to_check = "Manufacturer"

rows = details_for_label(records, label_to_check, case_insensitive=True)
if rows:
    print(f"Occurrences for label '{label_to_check}': {len(rows)}")
    if HAS_PANDAS:
        display(to_df(rows))
    else:
        print_table(rows, ["label", "iri_or_curie", "parent_label", "path"])
else:
    print(f"No rows found for label '{label_to_check}'.")



# Read the hierarchy from a text file in the same folder as your notebook
# Example file name: hierarchy.txt
# Make sure the indentation matches how it appears in Protégé (tabs or spaces).

file_name = "hierarchy.txt"  # <-- change if your file has a different name

with open(file_name, "r", encoding="utf-8") as f:
    hierarchy_str = f.read()

nodes = parse_hierarchy(hierarchy_str, spaces_per_level=2)
records = nodes_to_records(nodes)

print(f"Parsed {len(records)} classes from '{file_name}'.")


---------------------
3

# Show all parsed classes (table) + duplicates by label and IRI.

if HAS_PANDAS:
    df_nodes = to_df(records)
    display(df_nodes)  # All classes
else:
    print("\nAll classes:")
    print_table(records, ["idx", "depth", "label", "iri_or_curie", "parent_label", "path"])

# Repeated LABELS (case-insensitive by default)
label_dups = summarize_repeats_by_label(records, case_insensitive=True)
if HAS_PANDAS:
    df_label_summary = to_df(label_dups)
    display(df_label_summary)
else:
    print("\nRepeated labels (summary):")
    print_table(label_dups, ["label_norm", "occurrences", "distinct_parent_labels", "distinct_IRIs"])

# Expanded rows for repeated labels
expanded = []
for group, rows in repeated_labels(records, case_insensitive=True).items():
    expanded.extend(sorted(rows, key=lambda r: (r["label"].lower(), r["path"])))
if expanded:
    if HAS_PANDAS:
        display(to_df(expanded))
    else:
        print("\nRepeated labels (expanded):")
        print_table(expanded, ["label", "iri_or_curie", "parent_label", "path"])
else:
    print("\nNo repeated labels found.")

# Repeated IRIs (same IRI used in multiple places)
iri_dups = repeated_iris(records)
if iri_dups:
    rows = []
    for iri, rs in iri_dups.items():
        for r in rs:
            rows.append({"iri_or_curie": iri, "label": r["label"], "parent_label": r["parent_label"], "path": r["path"]})
    if HAS_PANDAS:
        display(to_df(rows))
    else:
        print("\nRepeated IRIs (expanded):")
        print_table(rows, ["iri_or_curie", "label", "parent_label", "path"])
else:
    print("\nNo repeated IRIs found.")



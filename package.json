                                                                                                                                                                                                      owl:someValuesFrom [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000202>
                                                                                                                                                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                                                                                                                                                  owl:onProperty [ owl:inverseOf <http://purl.obolibrary.org/obo/BFO_0000108>

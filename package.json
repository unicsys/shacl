                                                                                                                                                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                                                                                                                                                  owl:onProperty [ owl:inverseOf <http://purl.obolibrary.org/obo/BFO_0000108>
                                                                                                                                                                                                                                                                 ] ;
                                                                                                                                                                                                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000023>
                                                                                                                                                                                                                                                ]

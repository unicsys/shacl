                                                                                rdf:type owl:TransitiveProperty ;
                                                                                rdfs:domain [ rdf:type owl:Class ;
                                                                                              owl:unionOf ( <http://purl.obolibrary.org/obo/BFO_0000015>
                                                                                                            <http://purl.obolibrary.org/obo/BFO_0000202>
                                                                                                          )
                                                                                            ] ;
                                                                                rdfs:range [ rdf:type owl:Class ;
                                                                                             owl:unionOf ( <http://purl.obolibrary.org/obo/BFO_0000015>
                                                                                                           <http://purl.obolibrary.org/obo/BFO_0000202>
                                                                                                         )
                                                                                           ] ;
                                                                                rdfs:label "contains occurence of"@en-us ;
                                                                                <http://www.w3.org/2004/02/skos/core#example> "The grinding of metal contains occurrence of sparking; a storm contains occurrences of lightning."@en-us ;
                                                                                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> "https://dl.acm.org/doi/10.1145/182.358434" ;
                                                                                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/firstOrderLogicAxiom> "containsOccurrenceOf(x,y) ↔ occursDuring(y,x)" ;

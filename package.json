                                                                                                                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                                                                                                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000055> ;
                                                                                                                                                                                                   owl:someValuesFrom [ owl:intersectionOf ( <https://spec.industrialontologies.org/ontology/core/Core/BuyerRole>
                                                                                                                                                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                                                                                                                                                               owl:onProperty <https://spec.industrialontologies.org/ontology/core/Core/roleOf> ;
                                                                                                                                                                                                                                               owl:someValuesFrom <https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/Wholesaler>
                                                                                                                                                                                                                                             ]
                                                                                                                                                                                                                                           ) ;
                                                                                                                                                                                                                        rdf:type owl:Class
                                                                                                                                                                                                                      ]
                                                                                                                                                                                                 ]
                                                                                                                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                                                                                                                   owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000055> ;
                                                                                                                                                                                                   owl:someValuesFrom [ owl:intersectionOf ( <https://spec.industrialontologies.org/ontology/core/Core/MaterialProductRole>
                                                                                                                                                                                                                                             [ rdf:type owl:Restriction ;
                                                                                                                                                                                                                                               owl:onProperty <https://spec.industrialontologies.org/ontology/core/Core/roleOf> ;
                                                                                                                                                                                                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040>
                                                                                                                                                                                                                                             ]
                                                                                                                                                                                                                                           ) ;
                                                                                                                                                                                                                        rdf:type owl:Class
                                                                                                                                                                                                                      ]
                                                                                                                                                                                                 ]
                                                                                                                                                                                               ) ;

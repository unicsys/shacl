
# --- Duplicate class detector for indented Protégé hierarchy dumps ---
# Paste your hierarchy into `hierarchy_str` (next cell) and run all.

from dataclasses import dataclass, field
from typing import List, Tuple, Dict, Optional
import re
from collections import defaultdict

try:
    import pandas as pd
    HAS_PANDAS = True
except Exception:
    HAS_PANDAS = False


# ---------- Data model ----------
@dataclass
class Node:
    label: str
    iri_or_curie: Optional[str]
    depth: int
    parent_idx: Optional[int]
    idx: int
    path_labels: Tuple[str, ...] = field(default_factory=tuple)
    path_ids: Tuple[int, ...] = field(default_factory=tuple)


# ---------- Parsing helpers ----------
LEAD_INDENT_RE = re.compile(r'^(?P<indent>[ \t]*)(?P<text>.*)$')

def _compute_depth(indent_text: str, spaces_per_level: int = 2) -> int:
    """
    Convert leading indentation to a depth integer.
    - Tabs count as 1 level each
    - Spaces are grouped; every `spaces_per_level` spaces = 1 level
    Mixed tabs/spaces are added.
    """
    if not indent_text:
        return 0
    tabs = indent_text.count("\t")
    spaces = len(indent_text) - tabs
    return tabs + (spaces // spaces_per_level)

def _parse_label_and_iri(text: str) -> Tuple[str, Optional[str]]:
    """
    Extract a label and optional CURIE/IRI in trailing parentheses.
    Examples:
      "entity (BFO:0000001)" -> ("entity", "BFO:0000001")
      "MaterialArtifact"     -> ("MaterialArtifact", None)
    """
    text = text.strip()
    m = re.match(r"^(.*?)(?:\s*\(([^()]+)\)\s*)$", text)
    if m:
        label = m.group(1).strip()
        iri = m.group(2).strip()
        return label, iri
    return text, None


# ---------- Core parser ----------
def parse_hierarchy(text: str, spaces_per_level: int = 2) -> List[Node]:
    """
    Parse an indented list where indentation indicates subclassing.
    Returns a flat list of Nodes with parent indices and full paths.
    """
    nodes: List[Node] = []
    stack: List[int] = []  # node index at each depth
    lines = [ln for ln in text.splitlines() if ln.strip() != ""]
    for raw in lines:
        m = LEAD_INDENT_RE.match(raw)
        indent = m.group("indent")
        content = m.group("text")
        depth = _compute_depth(indent, spaces_per_level=spaces_per_level)
        label, iri = _parse_label_and_iri(content)

        while len(stack) > depth:
            stack.pop()

        parent_idx = stack[-1] if stack else None
        idx = len(nodes)

        if parent_idx is None:
            path_labels = (label,)
            path_ids = (idx,)
        else:
            parent = nodes[parent_idx]
            path_labels = (*parent.path_labels, label)
            path_ids = (*parent.path_ids, idx)

        node = Node(label=label, iri_or_curie=iri, depth=depth,
                    parent_idx=parent_idx, idx=idx,
                    path_labels=path_labels, path_ids=path_ids)
        nodes.append(node)

        if len(stack) == depth:
            stack.append(idx)
        else:
            # If indentation jumps multiple levels (messy paste), pad conservatively
            while len(stack) < depth:
                stack.append(idx)
            stack.append(idx)

    return nodes


# ---------- Data shaping ----------
def nodes_to_records(nodes: List[Node]) -> List[Dict]:
    recs = []
    for n in nodes:
        parent_label = nodes[n.parent_idx].label if n.parent_idx is not None else None
        recs.append({
            "idx": n.idx,
            "depth": n.depth,
            "label": n.label,
            "iri_or_curie": n.iri_or_curie,
            "parent_idx": n.parent_idx,
            "parent_label": parent_label,
            "path": " / ".join(n.path_labels),
        })
    return recs

def to_df(records: List[Dict]):
    if not HAS_PANDAS:
        raise RuntimeError("pandas not installed. Run: pip install --user pandas")
    return pd.DataFrame(records)


# ---------- Duplicate analysis ----------
def repeated_labels(records: List[Dict], case_insensitive: bool = True) -> Dict[str, List[Dict]]:
    """
    Return mapping: normalized_label -> list of records with that label.
    """
    buckets = defaultdict(list)
    for r in records:
        key = r["label"].lower() if case_insensitive else r["label"]
        buckets[key].append(r)
    return {k: v for k, v in buckets.items() if len(v) > 1}

def repeated_iris(records: List[Dict]) -> Dict[str, List[Dict]]:
    """
    Return mapping: iri -> list of records sharing that IRI (ignores None).
    """
    buckets = defaultdict(list)
    for r in records:
        iri = r.get("iri_or_curie")
        if iri:
            buckets[iri].append(r)
    return {k: v for k, v in buckets.items() if len(v) > 1}


def summarize_repeats_by_label(records: List[Dict], case_insensitive: bool = True) -> List[Dict]:
    out = []
    reps = repeated_labels(records, case_insensitive=case_insensitive)
    for norm_label, rows in reps.items():
        distinct_parents = sorted({(r["parent_label"] or "(root)") for r in rows})
        distinct_iris = sorted({r["iri_or_curie"] for r in rows if r["iri_or_curie"]}) or ["(none provided)"]
        out.append({
            "label_norm": norm_label,
            "occurrences": len(rows),
            "distinct_parent_labels": distinct_parents,
            "distinct_IRIs": distinct_iris,
        })
    out.sort(key=lambda d: (-d["occurrences"], d["label_norm"]))
    return out


def details_for_label(records: List[Dict], label: str, case_insensitive: bool = True) -> List[Dict]:
    key = label.lower() if case_insensitive else label
    return [
        r for r in records
        if (r["label"].lower() if case_insensitive else r["label"]) == key
    ]


# ---------- Pretty printers (for when pandas isn't available) ----------
def print_table(records: List[Dict], cols: List[str]):
    if not records:
        print("(no rows)")
        return
    widths = {c: max(len(c), *(len(str(r.get(c, ""))) for r in records)) for c in cols}
    line = " | ".join(c.ljust(widths[c]) for c in cols)
    sep = "-+-".join("-" * widths[c] for c in cols)
    print(line)
    print(sep)
    for r in records:
        print(" | ".join(str(r.get(c, "")).ljust(widths[c]) for c in cols))




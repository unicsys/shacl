# %%
# CORRECTED Code for Cell 2

class SQLAnalyzer:
    def __init__(self):
        """Initializes an in-memory DuckDB database."""
        self.conn = duckdb.connect(':memory:')
        print("✓ In-memory database is ready.")
        
    def load_schema_from_ddl(self, ddl_file_path):
        """Reads and executes a DDL file to create table schemas."""
        print(f"\n> Loading schema from '{ddl_file_path}'...")
        try:
            with open(ddl_file_path, 'r') as f:
                # *** THE FIX IS HERE ***
                # We use execute() to run a script, not executemany().
                self.conn.execute(f.read())

            print(f"✓ Schema DDL executed successfully.")
            
            # Now that the schema is created, we can set the search path.
            self.conn.execute("SET search_path = 'HAMR';")
            print("✓ Search path successfully set to 'HAMR'.")

        except Exception as e:
            print(f"❌ Error loading DDL: {e}")

    def list_tables(self):
        """Lists all tables created in the database."""
        print("\n> Checking created tables...")
        tables_df = self.conn.execute("SELECT table_name FROM information_schema.tables WHERE table_schema = 'HAMR'").df()
        return tables_df
        
    def analyze(self, query):
        """Runs an analysis query and returns the result as a DataFrame."""
        print("\n> Running analysis query...")
        try:
            result_df = self.conn.execute(query).df()
            print(f"✓ Query successful, returned {len(result_df)} rows.")
            return result_df
        except Exception as e:
            print(f"❌ Query failed: {e}")
            return None

# %%

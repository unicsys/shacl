                                                                                                                                                                                                      owl:onProperty <https://spec.industrialontologies.org/ontology/core/Core/metBy> ;
                                                                                                                                                                                                      owl:someValuesFrom [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000202>
                                                                                                                                                                                                                                                [ rdf:type owl:Restriction ;

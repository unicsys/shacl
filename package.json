import requests
import urllib.parse
import json

# --- Configuration ---
MOBI_HOST = "https://localhost:8443"

API_TOKEN = "eyJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJodHRwOi8vbW9iaS5jb20vIiwic3ViIjoiYWRtaW4iLCJleHAiOjE3NjE4NzY3OTQsInNjb3BlIjoic2VsZiAvKiJ9.OC_DpbTr1Ra4NZLjn-OJ7nfhrnWSaUJh6-5xpyW73pE"

RECORD_IRI = "https://mobi.com/records#dfc62b1c-f039-4b44-93b9-f426f3360f44"

# >> EDIT THIS SECTION <<
# This SPARQL query will find Circuit Card Assembly details, including serial number, part number, and revision.
SPARQL_QUERY = """
PREFIX ockms: <https://ontologyhub.rtx.com/RTXEnterpriseOntologies/OCKMSDigitalThreadOntology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX iof-core: <https://spec.industrialontologies.org/ontology/core/Core/>
PREFIX bfo: <http://purl.obolibrary.org/obo/>

SELECT ?cca ?serial ?partNumber ?revision
WHERE {
  ?cca a ockms:CircuitCardAssembly ;
       rdfs:label ?label .
  
  ?ccaId a ockms:CircuitCardAssemblyIdentifier ;
         iof-core:designates ?cca ;
         ockms:hasTextValue ?serial .
  
  ?designRev a ockms:CircuitCardAssemblyDesignRevision ;
             iof-core:prescribes ?cca ;
             rdfs:label ?revLabel .
  
  ?design a ockms:CircuitCardAssemblyDesign ;
          bfo:BFO_0000110 ?designRev .
  
  ?designId a ockms:CircuitCardAssemblyDesignIdentifier ;
            iof-core:designates ?design ;
            ockms:hasTextValue ?partNumber .
  
  ?revId a ockms:CircuitCardAssemblyDesignRevisionIdentifier ;
         iof-core:designates ?designRev ;
         ockms:hasTextValue ?revision .
}
ORDER BY ?partNumber ?revision ?serial
"""
# >> END OF EDIT SECTION <<
 

def run_query_raw():

    if " " in API_TOKEN:
        print("Error: Please update your API_TOKEN")
        return

    print(f"Querying with custom SPARQL query from: {RECORD_IRI}")

    store_type = "dataset-record"
    encoded_iri = urllib.parse.quote(RECORD_IRI, safe='')
    url = f"{MOBI_HOST}/mobirest/sparql/{store_type}/{encoded_iri}/limited-results"

    headers = {
        'Cookie': f'mobi_web_token={API_TOKEN}',
        'Accept': 'application/json',
        'Content-Type': 'application/x-www-form-urlencoded'
    }
    
    try:
        requests.packages.urllib3.disable_warnings()
        # The complete SPARQL_QUERY is passed directly in the 'data' payload
        response = requests.post(url, headers=headers, data={'query': SPARQL_QUERY}, verify=False)
        response.raise_for_status()
        
        print("\n--- API Response ---")
        raw_json_text = response.text

        try:
            parsed_json = json.loads(raw_json_text)
            pretty_raw_json = json.dumps(parsed_json, indent=2)
            print(pretty_raw_json)
        except json.JSONDecodeError:
            print(raw_json_text)

    except requests.exceptions.RequestException as e:
        print(f"\nError during API request: {e}")
        if hasattr(e, 'response') and e.response:
            print(f"Server response: {e.response.text}")

if __name__ == "__main__":
    run_query_raw()

import requests
import urllib.parse
import json

# --- Configuration ---
MOBI_HOST = "https://localhost:8443"

API_TOKEN = "eyJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJodHRwOi8vbW9iaS5jb20vIiwic3ViIjoiYWRtaW4iLCJleHAiOjE3NjE3NDU2NTksInNjb3BlIjoic2VsZiAvKiJ9.cyoDm-2TwLwgN8zxvpFD-ga5pVffmTXHZ_64idQHTEg"

RECORD_IRI = "https://mobi.com/records#96e3fd11-0fc5-4c15-b032-165fb2101976"

# >> EDIT THIS SECTION <<
QUERY_LIMIT = 5

SPARQL_QUERY_TEMPLATE = """
SELECT ?subject ?predicate ?object
WHERE {{
  ?subject ?predicate ?object .
}}
LIMIT {limit}
"""
# >> END OF EDIT SECTION <<
 

def run_query_raw():

    if " " in API_TOKEN:
        print("Error: Please update your API_TOKEN")
        return

    # This line inserts the Python variable into the query template
    final_query = SPARQL_QUERY_TEMPLATE.format(limit=QUERY_LIMIT)

    print(f"Querying for {QUERY_LIMIT} triples from: {RECORD_IRI}")

    store_type = "dataset-record"
    encoded_iri = urllib.parse.quote(RECORD_IRI, safe='')
    url = f"{MOBI_HOST}/mobirest/sparql/{store_type}/{encoded_iri}/limited-results"

    headers = {
        'Cookie': f'mobi_web_token={API_TOKEN}',
        'Accept': 'application/json',
        'Content-Type': 'application/x-www-form-urlencoded'
    }
    
    try:
        requests.packages.urllib3.disable_warnings()
        response = requests.post(url, headers=headers, data={'query': final_query}, verify=False)
        response.raise_for_status()
        
        print("\n--- API Response ---")
        raw_json_text = response.text

        try:
            parsed_json = json.loads(raw_json_text)
            pretty_raw_json = json.dumps(parsed_json, indent=2)
            print(pretty_raw_json)
        except json.JSONDecodeError:
            print(raw_json_text)

    except requests.exceptions.RequestException as e:
        print(f"\nError during API request: {e}")
        if e.response:
            print(f"Server response: {e.response.text}")

if __name__ == "__main__":
    run_query_raw()

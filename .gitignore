import ijson

# ---------------------------------------------------------
# CONFIGURATION
# ---------------------------------------------------------
INPUT_FILE = 'sample.json' 
TARGET_PART_NUMBER = "822-2132-003"  # <--- Change this to the part you want to check

def count_unique_units_for_part(input_path, target_part):
    print(f"Searching for Part Number: {target_part} in {input_path}...")
    
    # We use a Python 'set'. Sets automatically handle uniqueness.
    # If we add "SN123" five times, the set only keeps it once.
    unique_serial_numbers = set()
    
    row_count = 0
    
    try:
        with open(input_path, 'rb') as f:
            # Stream the file item by item
            for item in ijson.items(f, 'item'):
                
                # Check if this record matches the part number we want
                # We use .get() to avoid errors if keys are missing
                part_no = item.get('partNo')
                uut_sn = item.get('uutSn')
                
                if part_no == target_part:
                    if uut_sn: # Ensure SN is not None or empty
                        unique_serial_numbers.add(uut_sn)
                
                row_count += 1
                if row_count % 10000 == 0:
                    print(f"Scanned {row_count} rows...", end='\r')

    except FileNotFoundError:
        print(f"Error: The file '{input_path}' was not found.")
        return

    # ---------------------------------------------------------
    # OUTPUT
    # ---------------------------------------------------------
    count = len(unique_serial_numbers)
    
    print("\n" + "="*50)
    print(f"REPORT FOR PART: {target_part}")
    print("="*50)
    print(f"Total Unique Units Found: {count}")
    print("="*50)
    
    # Optional: Print the actual serial numbers if the list is short
    if count > 0 and count <= 20:
        print("\nSerial Numbers found:")
        print(", ".join(sorted(unique_serial_numbers)))
    elif count > 20:
        print(f"\n(List of serial numbers hidden because there are {count} of them)")

if __name__ == "__main__":
    count_unique_units_for_part(INPUT_FILE, TARGET_PART_NUMBER)

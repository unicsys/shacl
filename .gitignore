# Import the necessary libraries from Hugging Face Transformers
import torch
from transformers import AutoProcessor, Gemma3ForConditionalGeneration
from PIL import Image
import requests

# 1. Load the processor and the model from the pre-trained source
# The Docker image should have this model cached, so it should load quickly.
model_id = "google/gemma-3-12b-it"

# The processor handles both text tokenization and image processing
processor = AutoProcessor.from_pretrained(model_id)

# Gemma3ForConditionalGeneration is the model architecture for this task
# device_map="auto" will automatically use the available GPU
model = Gemma3ForConditionalGeneration.from_pretrained(
    model_id,
    device_map="auto",
    torch_dtype=torch.bfloat16 # Use bfloat16 for better performance on modern GPUs
).eval()


# 2. Create a text-only prompt
# The model expects the input in a specific conversational format.
# The role 'user' indicates the start of a user's question or instruction.
prompt_text = "What are the most interesting things to see in Paris?"
messages = [{"role": "user", "content": prompt_text}]

# The processor converts the conversational format into the correct input format for the model.
inputs = processor.apply_chat_template(messages, add_generation_prompt=True, tokenize=True, return_tensors="pt").to(model.device)


# 3. Generate a response
print("Generating response for the text prompt...")
response = model.generate(**inputs, max_new_tokens=256)

# 4. Decode and print the output
# We use the processor to decode the generated token IDs back into readable text.
# The `skip_special_tokens=True` argument removes any special formatting tokens.
decoded_response = processor.decode(response[0], skip_special_tokens=True)

# The output includes your original prompt, so we can clean it up for display.
# This finds the start of the model's actual response.
model_response_start = decoded_response.find("<start_of_turn>model\n") + len("<start_of_turn>model\n")
final_response = decoded_response[model_response_start:]

print("\n--- Model Response ---")
print(final_response)
print("--------------------")

import pandas as pd

def check_uniqueness(df, columns, name):
    """
    Checks if a specific combination of columns is unique across the whole file.
    """
    # Create a composite key by joining the columns with a pipe |
    # We convert to string and handle nulls to ensure accuracy
    composite = df[columns].apply(lambda x: '|'.join(x.dropna().astype(str)), axis=1)
    
    total_rows = len(df)
    unique_count = composite.nunique()
    
    is_unique = (total_rows == unique_count)
    
    print(f"--- Strategy: {name} ---")
    print(f"Columns: {columns}")
    print(f"Unique Records: {unique_count} / {total_rows}")
    print(f"Is Unique? {'✅ YES (Safe to use)' if is_unique else '❌ NO (Duplicates found)'}")
    print("")
    return is_unique

def main():
    csv_path = "sample_data.csv"  # <--- Point this to your large file
    
    print("Loading CSV...")
    # Read CSV (Low memory mode false to handle mixed types warning on large files)
    df = pd.read_csv(csv_path, low_memory=False)
    
    print(f"Total Rows Loaded: {len(df)}\n")

    # ---------------------------------------------------------
    # STRATEGY 1: Serial Number Only (We expect this to fail)
    # ---------------------------------------------------------
    check_uniqueness(df, ['1stLevelSerial'], "Serial Number Only")

    # ---------------------------------------------------------
    # STRATEGY 2: Serial + Sequence Number (Likely Candidate)
    # ---------------------------------------------------------
    check_uniqueness(df, ['1stLevelSerial', 'SeqNum'], "Serial + SeqNum")

    # ---------------------------------------------------------
    # STRATEGY 3: Serial + Defect Code (Logical)
    # ---------------------------------------------------------
    check_uniqueness(df, ['1stLevelSerial', 'DefCode'], "Serial + DefectCode")

    # ---------------------------------------------------------
    # STRATEGY 4: Serial + Timestamp (Temporal)
    # ---------------------------------------------------------
    check_uniqueness(df, ['1stLevelSerial', 'CreatedOn', 'CreatTime'], "Serial + Timestamp")

    # ---------------------------------------------------------
    # STRATEGY 5: Inspection Lot + SeqNum (ERP Style)
    # ---------------------------------------------------------
    check_uniqueness(df, ['InspLot#', 'SeqNum'], "Inspection Lot + SeqNum")

if __name__ == "__main__":
    main()

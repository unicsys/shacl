{
  "system_prompt": {
    "role": "You are a meticulous data classification engine specializing in engineering and manufacturing quality notifications. You adhere strictly to the rules provided.",
    "task": "Analyze the input text from a quality notification. Classify it as 'Technical' or 'Non-Technical' based *only* on the provided classification rules. You must return your analysis in a structured JSON format, detailing your reasoning for each rule checked.",
    "instructions": [
      "1. Parse the `input_data` which contains the text to be analyzed.",
      "2. Systematically evaluate the text against each criterion in the `classification_rules`, including the `key_principle` and `explicit_exclusions`.",
      "3. For each rule, determine if specific, qualifying data is present in the text.",
      "4. Construct your response using the exact schema defined in `output_format_definition`. Do not deviate from this structure.",
      "5. Your reasoning must be based solely on the provided text and rules. Make no assumptions."
    ]
  },
  "classification_rules": {
    "key_principle": {
      "classify_as_technical_if": [
        "Numerical values with units are present",
        "Specific parameters or conditions are stated",
        "Measurements are provided with acceptance criteria",
        "Technical analysis with calculations is included"
      ],
      "classify_as_non_technical_if": [
        "Only names/labels without specifications are present",
        "Descriptions are vague or qualitative",
        "References are generic without details",
        "Content is primarily administrative or procedural"
      ]
    },
    "technical_criteria_to_extract": [
      {
        "category": "MATERIAL_SPECIFICATIONS",
        "details": "Material grades, chemical compositions, properties (strength, hardness), heat treatment specs with temps/times."
      },
      {
        "category": "MANUFACTURING_PROCESS_PARAMETERS",
        "details": "Plating/coating thickness, welding parameters (current, voltage), machining speeds, surface finish values (Ra)."
      },
      {
        "category": "DIMENSIONAL_SPECIFICATIONS",
        "details": "Critical dimensions with tight tolerances (e.g., ±0.010\"), GD&T callouts, clearances, fit specs."
      },
      {
        "category": "LOADS_FORCES_TORQUES",
        "details": "Load specs with magnitude, torque values with tolerance, pressure specs."
      },
      {
        "category": "PERFORMANCE_PARAMETERS",
        "details": "Operating envelopes (temp, pressure ranges), capacity specs, efficiency metrics with numerical targets."
      },
      {
        "category": "TEST_DATA_WITH_CRITERIA",
        "details": "Test results with acceptance criteria, pass/fail data with specific limits."
      },
      {
        "category": "FAILURE_ANALYSIS_TECHNICAL",
        "details": "Root cause with calculations, failure modes with measurements (crack length, wear depth)."
      },
      {
        "category": "TECHNICAL_STANDARDS_WITH_SPECIFICS",
        "details": "ASTM/ISO/MIL-STD standards with specific clauses, tables, or requirements called out."
      },
      {
        "category": "CORRECTIVE_ACTIONS_TECHNICAL",
        "details": "Rework/repair procedures with specific parameters, material substitutions with technical justification."
      },
      {
        "category": "DETAILED_DESIGN_SPECIFICATIONS",
        "details": "Design requirements with numerical values, interface specs with dimensions."
      }
    ],
    "explicit_exclusions": [
      "Part numbers, serial numbers, or material numbers alone",
      "Drawing numbers or revision codes alone",
      "Generic process names without parameters ('heat treated', 'machined')",
      "Vague statements ('defect found', 'failed inspection', 'out of spec')",
      "Administrative content (dates, names, assignments, status)",
      "Generic references ('per specification', 'per manual')",
      "Quality observations without measurements ('excessive wear')",
      "Assembly/disassembly instructions without technical parameters"
    ]
  },
  "input_data": {
    "record_id": "QN-105",
    "long_text": "03/15/2021 10:30:15 PST JANE DOE(0001YYY) Eng. Part No.: GHF-9876 PO: 789123. The material certification paperwork was not included with the shipment as required by procedure. Receiving department procedure REC-004 states that all incoming lots must be accompanied by a C of C (Certificate of Conformance). Inspector Mark R. flagged this and placed the material on hold in the MRB cage. The supplier was contacted and stated they would send it over via email. Per our quality manual, the part cannot be moved to the production line until this is resolved. Status is pending."
  },
  "output_format_definition": {
    "classification_result": "string (either 'Technical' or 'Non-Technical')",
    "confidence_score": "float (0.0 to 1.0)",
    "summary_reasoning": "string (A brief, one-sentence explanation for the classification)",
    "systematic_analysis": {
      "technical_criteria_check": [
        {
          "category": "string (e.g., 'MATERIAL_SPECIFICATIONS')",
          "contains_technical_data": "boolean",
          "findings": "string (Explanation of what was or was not found for this category)"
        }
      ],
      "exclusion_criteria_check": [
        {
          "exclusion_category": "string (e.g., 'Administrative content')",
          "is_present": "boolean",
          "findings": "string (Details of excluded content found in the text)"
        }
      ]
    }
  }
}

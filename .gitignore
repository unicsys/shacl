import requests
import urllib.parse

# Configuration
MOBI_HOST = "https://localhost:8443"
API_TOKEN = "eyJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJodHRwOi8vbW9iaS5jb20vIiwic3ViIjoiYWRtaW4iLCJleHAiOjE3NjExNDIyMDMsInNjb3BlIjoic2VsZiAvKiJ9._umAkHgoNnAlMqNZioBTPu7rMJW35BnVBqp3pnWxfiM"

CATALOG_IRI = "http://mobi.com/catalog-local"

def fetch_record_iris():
    """Fetches and prints the IRIs for all records in a Mobi catalog."""
    
    if API_TOKEN == "your_full_api_token_here":
        print("Error: Please configure your API_TOKEN before running.")
        return

    encoded_catalog = urllib.parse.quote(CATALOG_IRI, safe='')
    url = f"{MOBI_HOST}/mobirest/catalogs/{encoded_catalog}/records"
    
    headers = {'Cookie': f'mobi_web_token={API_TOKEN}'}
    params = {'limit': 100, 'offset': 0, 'sort': 'http://purl.org/dc/terms/title'}
    
    try:
        # Suppress insecure request warnings for localhost
        requests.packages.urllib3.disable_warnings()
        response = requests.get(url, headers=headers, params=params, verify=False)
        response.raise_for_status()
        
        records = response.json()
        
        if not records:
            print("No records found in the specified catalog.")
            return
            
        print("Found Records:")
        for record in records:
            title = record.get('http://purl.org/dc/terms/title', [{}])[0].get('@value', 'No Title')
            iri = record.get('@id')
            print(f"- {title}\n  {iri}\n")

    except requests.exceptions.RequestException as e:
        print(f"API request failed: {e}")

if __name__ == "__main__":
    fetch_record_iris()

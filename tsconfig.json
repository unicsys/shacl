import React, { useState, useRef, useEffect, useCallback, useMemo } from 'react';
import { Download, Upload, Plus, MoveHorizontal, Minimize2, Maximize2, Edit3, Check, X } from 'lucide-react';

const OntologyCanvas = () => {
  const [tabs, setTabs] = useState([
    {
      id: '1',
      name: 'Canvas 1',
      boxes: [],
      relations: [],
      scopeText: 'What part serial numbers were on the engine at a given time?',
      csvData: '',
      tableData: [],
      useTable: false,
      headerColors: {}
    }
  ]);
  const [activeTabId, setActiveTabId] = useState('1');
  const [editingTabId, setEditingTabId] = useState(null);
  
  const [selectedBox, setSelectedBox] = useState(null);
  const [draggingBox, setDraggingBox] = useState(null);
  const [connectingFrom, setConnectingFrom] = useState(null);
  const [editingBox, setEditingBox] = useState(null);
  const [editingRelation, setEditingRelation] = useState(null);
  const [isHeaderCollapsed, setIsHeaderCollapsed] = useState(false);
  const canvasRef = useRef(null);
  const [dragOffset, setDragOffset] = useState({ x: 0, y: 0 });

  const AVAILABLE_COLORS = useMemo(() => [
    '#3B82F6', '#10B981', '#8B5CF6', '#EF4444', '#F59E0B', '#EC4899',
    '#14B8A6', '#6366F1', '#EAB308', '#06B6D4', '#F97316', '#84CC16'
  ], []);

  const COLUMNS = useMemo(() => [
    { id: 'material', name: 'Material Things', widthPercent: 15, subsections: [], color: '#3B82F6' },
    { 
      id: 'qualities', name: 'Qualities, Functions, Roles', widthPercent: 20, color: '#8B5CF6',
      subsections: [
        { name: 'Qualities', y: 0 },
        { name: 'Functions', y: 233 },
        { name: 'Roles', y: 466 }
      ]
    },
    { 
      id: 'information', name: 'Information Things', widthPercent: 30, color: '#10B981',
      subsections: [
        { name: 'Descriptive Data', y: 0 },
        { name: 'Prescriptive Data', y: 233 },
        { name: 'Identifiers', y: 466 }
      ]
    },
    { id: 'processes', name: 'Processes', widthPercent: 20, color: '#F59E0B', subsections: [] },
    { id: 'time', name: 'Time Periods', widthPercent: 15, color: '#EF4444', subsections: [] }
  ], []);

  const activeTab = useMemo(() => tabs.find(t => t.id === activeTabId), [tabs, activeTabId]);
  const boxes = activeTab?.boxes || [];
  const relations = activeTab?.relations || [];
  const scopeText = activeTab?.scopeText || '';
  const csvData = activeTab?.csvData || '';
  const tableData = activeTab?.tableData || [];
  const useTable = activeTab?.useTable || false;
  const headerColors = activeTab?.headerColors || {};

  const updateActiveTab = useCallback((updates) => {
    setTabs(prev => prev.map(tab => 
      tab.id === activeTabId ? { ...tab, ...updates } : tab
    ));
  }, [activeTabId]);

  const setBoxes = useCallback((updater) => {
    updateActiveTab({ boxes: typeof updater === 'function' ? updater(boxes) : updater });
  }, [updateActiveTab, boxes]);

  const setRelations = useCallback((updater) => {
    updateActiveTab({ relations: typeof updater === 'function' ? updater(relations) : updater });
  }, [updateActiveTab, relations]);

  const setScopeText = useCallback((value) => {
    updateActiveTab({ scopeText: value });
  }, [updateActiveTab]);

  const setCsvData = useCallback((value) => {
    updateActiveTab({ csvData: value });
  }, [updateActiveTab]);

  const setTableData = useCallback((value) => {
    updateActiveTab({ tableData: value });
  }, [updateActiveTab]);

  const setUseTable = useCallback((value) => {
    updateActiveTab({ useTable: value });
  }, [updateActiveTab]);

  const setHeaderColors = useCallback((updater) => {
    updateActiveTab({ headerColors: typeof updater === 'function' ? updater(headerColors) : updater });
  }, [updateActiveTab, headerColors]);

  // Tab management
  const addTab = useCallback(() => {
    const newId = Date.now().toString();
    const newTab = {
      id: newId,
      name: `Canvas ${tabs.length + 1}`,
      boxes: [],
      relations: [],
      scopeText: '',
      csvData: '',
      tableData: [],
      useTable: false,
      headerColors: {}
    };
    setTabs(prev => [...prev, newTab]);
    setActiveTabId(newId);
  }, [tabs.length]);

  const deleteTab = useCallback((tabId, e) => {
    e.stopPropagation();
    if (tabs.length === 1) return;
    
    const tabIndex = tabs.findIndex(t => t.id === tabId);
    setTabs(prev => prev.filter(t => t.id !== tabId));
    
    if (activeTabId === tabId) {
      const newActiveTab = tabs[tabIndex === 0 ? 1 : tabIndex - 1];
      setActiveTabId(newActiveTab.id);
    }
  }, [tabs, activeTabId]);

  const renameTab = useCallback((tabId, newName) => {
    setTabs(prev => prev.map(tab => 
      tab.id === tabId ? { ...tab, name: newName } : tab
    ));
    setEditingTabId(null);
  }, []);

  // Keyboard shortcuts
  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === 'Delete' && selectedBox && !editingBox) {
        deleteBox(selectedBox);
      }
      if (e.key === 'Escape') {
        setConnectingFrom(null);
        setEditingBox(null);
        setEditingRelation(null);
        setEditingTabId(null);
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [selectedBox, editingBox]);

  // CSV parsing
  const handleCsvInput = useCallback((text) => {
    setCsvData(text);
    if (text.trim()) {
      const lines = text.trim().split('\n');
      if (lines.length > 0) {
        const parsed = lines.map(line => 
          line.split(/,|\t/).map(cell => cell.trim())
        );
        setTableData(parsed);
        
        if (parsed.length > 0) {
          setHeaderColors(prevColors => {
            const newColors = { ...prevColors };
            parsed[0].forEach((header, idx) => {
              if (!(header in newColors) || newColors[header] === null) {
                newColors[header] = AVAILABLE_COLORS[idx % AVAILABLE_COLORS.length];
              }
            });
            return newColors;
          });
        }
      }
    } else {
      setTableData([]);
      setHeaderColors({});
    }
  }, [setCsvData, setTableData, setHeaderColors, AVAILABLE_COLORS]);

  // Add box
  const addBox = useCallback((columnId, subsectionY = null) => {
    const columnIndex = COLUMNS.findIndex(c => c.id === columnId);
    const canvasWidth = canvasRef.current?.offsetWidth || 1400;
    
    let xPos = 0;
    for (let i = 0; i < columnIndex; i++) {
      xPos += (COLUMNS[i].widthPercent / 100) * canvasWidth;
    }
    
    const existingBoxes = boxes.filter(b => b.column === columnId && b.subsection === subsectionY);
    const baseY = subsectionY !== null ? subsectionY + 50 : 150;
    
    const newBox = {
      id: Date.now().toString(),
      label: 'New Item',
      column: columnId,
      subsection: subsectionY,
      x: xPos + 25,
      y: baseY + (existingBoxes.length * 90),
      headerTag: null,
      headerColor: null
    };
    
    setBoxes(prev => [...prev, newBox]);
    setEditingBox(newBox.id);
  }, [boxes, COLUMNS, setBoxes]);

  const deleteBox = useCallback((boxId) => {
    setBoxes(prev => prev.filter(b => b.id !== boxId));
    setRelations(prev => prev.filter(r => r.from !== boxId && r.to !== boxId));
    setSelectedBox(null);
  }, [setBoxes, setRelations]);

  const updateBoxLabel = useCallback((boxId, newLabel) => {
    setBoxes(prev => prev.map(b => b.id === boxId ? { ...b, label: newLabel } : b));
    setEditingBox(null);
  }, [setBoxes]);

  const handleMouseDown = useCallback((e, box) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
    e.preventDefault();
    
    const rect = canvasRef.current.getBoundingClientRect();
    setDragOffset({
      x: e.clientX - rect.left - box.x,
      y: e.clientY - rect.top - box.y
    });
    setDraggingBox(box.id);
    setSelectedBox(box.id);
  }, []);

  const handleMouseMove = useCallback((e) => {
    if (draggingBox) {
      e.preventDefault();
      const rect = canvasRef.current.getBoundingClientRect();
      const newX = Math.max(0, e.clientX - rect.left - dragOffset.x);
      const newY = Math.max(0, e.clientY - rect.top - dragOffset.y);
      
      setBoxes(prev => prev.map(b => 
        b.id === draggingBox ? { ...b, x: newX, y: newY } : b
      ));
    }
  }, [draggingBox, dragOffset, setBoxes]);

  const handleMouseUp = useCallback(() => {
    setDraggingBox(null);
  }, []);

  const startConnection = useCallback((boxId) => {
    setConnectingFrom(boxId);
  }, []);

  const completeConnection = useCallback((toBoxId) => {
    if (connectingFrom && connectingFrom !== toBoxId) {
      const newRelation = {
        id: Date.now().toString(),
        from: connectingFrom,
        to: toBoxId,
        label: 'relates to'
      };
      setRelations(prev => [...prev, newRelation]);
    }
    setConnectingFrom(null);
  }, [connectingFrom, setRelations]);

  const deleteRelation = useCallback((relationId) => {
    setRelations(prev => prev.filter(r => r.id !== relationId));
    setEditingRelation(null);
  }, [setRelations]);

  const updateRelationLabel = useCallback((relationId, newLabel) => {
    setRelations(prev => prev.map(r => r.id === relationId ? { ...r, label: newLabel } : r));
    setEditingRelation(null);
  }, [setRelations]);

  const exportData = useCallback(() => {
    const data = { 
      tabs,
      activeTabId,
      exportDate: new Date().toISOString()
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    const timestamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, -5);
    a.download = `ontology-canvas-${timestamp}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }, [tabs, activeTabId]);

  const importData = useCallback((e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const data = JSON.parse(event.target.result);
          if (data.tabs) {
            setTabs(data.tabs);
            setActiveTabId(data.tabs[0]?.id || '1');
          } else {
            // Legacy format support
            setTabs([{
              id: '1',
              name: 'Canvas 1',
              boxes: data.boxes || [],
              relations: data.relations || [],
              scopeText: data.scopeText || '',
              tableData: data.tableData || [],
              useTable: data.useTable || false,
              csvData: data.csvData || '',
              headerColors: data.headerColors || {}
            }]);
            setActiveTabId('1');
          }
        } catch (err) {
          alert('Error importing file: ' + err.message);
        }
      };
      reader.readAsText(file);
    }
  }, []);

  const getBoxCenter = useCallback((boxId) => {
    const box = boxes.find(b => b.id === boxId);
    return box ? { x: box.x + 70, y: box.y + 15 } : { x: 0, y: 0 };
  }, [boxes]);

  const getColumnLeftPosition = useCallback((colIdx) => {
    const canvasWidth = canvasRef.current?.offsetWidth || 1400;
    let xPos = 0;
    for (let i = 0; i < colIdx; i++) {
      xPos += (COLUMNS[i].widthPercent / 100) * canvasWidth;
    }
    return xPos;
  }, [COLUMNS]);

  const handleCanvasClick = useCallback(() => {
    setSelectedBox(null);
    setConnectingFrom(null);
  }, []);

  const handleTableToggle = useCallback((checked) => {
    setUseTable(checked);
    if (!checked) {
      setCsvData('');
      setTableData([]);
    }
  }, [setUseTable, setCsvData, setTableData]);

  const updateBoxHeaderTag = useCallback((boxId, selectedHeader) => {
    setBoxes(prev => prev.map(b => 
      b.id === boxId 
        ? { 
            ...b, 
            headerTag: selectedHeader || null,
            headerColor: selectedHeader ? headerColors[selectedHeader] : null
          } 
        : b
    ));
  }, [headerColors, setBoxes]);

  const isHeaderInUse = useCallback((header) => {
    return boxes.some(box => box.headerTag === header);
  }, [boxes]);

  return (
    <div className="w-full h-screen flex flex-col bg-gradient-to-br from-gray-50 to-gray-100">
      {/* Header */}
      <div className="bg-white shadow-md border-b border-gray-200 transition-all duration-300">
        <div className={`px-4 transition-all duration-300 ${isHeaderCollapsed ? 'py-2' : 'py-4'}`}>
          <div className="flex items-start gap-4">
            <button
              onClick={() => setIsHeaderCollapsed(!isHeaderCollapsed)}
              className="mt-1 p-2 hover:bg-gray-100 rounded-lg transition-colors"
              title={isHeaderCollapsed ? "Expand" : "Collapse"}
            >
              {isHeaderCollapsed ? <Maximize2 size={18} /> : <Minimize2 size={18} />}
            </button>
            
            {!isHeaderCollapsed && (
              <div className="flex-1">
                <div className="flex items-center justify-between mb-3">
                  <label className="text-sm font-bold text-gray-800 flex items-center gap-2">
                    <span className="text-blue-600">●</span>
                    Ontology Modeling Scope
                  </label>
                  <label className="flex items-center gap-2 text-sm text-gray-700 cursor-pointer hover:text-gray-900">
                    <input
                      type="checkbox"
                      checked={useTable}
                      onChange={(e) => handleTableToggle(e.target.checked)}
                      className="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                    />
                    Use Table Input
                  </label>
                </div>
                
                {!useTable ? (
                  <input
                    type="text"
                    value={scopeText}
                    onChange={(e) => setScopeText(e.target.value)}
                    className="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm"
                    placeholder="Enter your modeling scope question..."
                  />
                ) : (
                  <>
                    <textarea
                      value={csvData}
                      onChange={(e) => handleCsvInput(e.target.value)}
                      className="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm"
                      rows="3"
                      placeholder="Paste CSV or tab-separated data (e.g., ENGINE_SN,DEFECT_DTG,JCN...)"
                    />
                    {tableData.length > 0 && (
                      <div className="mt-3 overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
                        <table className="min-w-full text-xs">
                          <thead>
                            <tr className="bg-gradient-to-r from-blue-50 to-indigo-50">
                              {tableData[0].map((header, idx) => {
                                const inUse = isHeaderInUse(header);
                                const headerColor = inUse ? headerColors[header] : '#000';
                                
                                return (
                                  <th 
                                    key={idx} 
                                    className="border-b border-gray-300 px-3 py-2 font-semibold text-gray-800 text-left relative"
                                  >
                                    <div className="flex items-center gap-2">
                                      <span 
                                        className="font-bold"
                                        style={{ 
                                          color: headerColor,
                                          textDecoration: inUse ? `underline 3px solid ${headerColor}` : 'none',
                                          textUnderlineOffset: '4px'
                                        }}
                                      >
                                        {header}
                                      </span>
                                      <div
                                        className="w-3 h-3 rounded-full border border-gray-300"
                                        style={{ backgroundColor: inUse ? headerColor : '#ccc' }}
                                        title={`Color: ${headerColors[header]}`}
                                      />
                                    </div>
                                  </th>
                                );
                              })}
                            </tr>
                          </thead>
                          <tbody>
                            {tableData.slice(1).map((row, rowIdx) => (
                              <tr key={rowIdx} className="hover:bg-gray-50 transition-colors">
                                {row.map((cell, cellIdx) => (
                                  <td key={cellIdx} className="border-b border-gray-200 px-3 py-2 text-gray-700">
                                    {cell}
                                  </td>
                                ))}
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    )}
                  </>
                )}
              </div>
            )}
            
            <div className="flex gap-2">
              <button
                onClick={exportData}
                className="flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-lg hover:from-blue-700 hover:to-blue-800 shadow-md hover:shadow-lg transition-all text-sm font-medium whitespace-nowrap"
                title="Export to JSON"
              >
                <Download size={16} />
                {!isHeaderCollapsed && "Export"}
              </button>
              <label className="flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-green-600 to-green-700 text-white rounded-lg hover:from-green-700 hover:to-green-800 shadow-md hover:shadow-lg transition-all cursor-pointer text-sm font-medium whitespace-nowrap"
                title="Import from JSON">
                <Upload size={16} />
                {!isHeaderCollapsed && "Import"}
                <input type="file" accept=".json" onChange={importData} className="hidden" />
              </label>
            </div>
          </div>
        </div>
      </div>

      {/* Column Headers */}
      <div className="bg-white shadow-sm">
        <div className="flex border-b-2 border-gray-300">
          <div className="text-center font-bold text-xs py-1 border-r-2 border-gray-300 bg-gray-50" style={{ width: '65%' }}>
            Things That Exist
          </div>
          <div className="text-center font-bold text-xs py-1 bg-gray-50" style={{ width: '35%' }}>
            Things That Happen
          </div>
        </div>
        
        <div className="flex w-full">
          {COLUMNS.map((col) => (
            <div
              key={col.id}
              className="border-r border-gray-300 last:border-r-0 px-2 py-1.5 hover:bg-gray-50 transition-colors"
              style={{ width: `${col.widthPercent}%` }}
            >
              <div className="text-center">
                {col.subsections.length === 0 ? (
                  <div className="flex items-center justify-center gap-1.5">
                    <button
                      onClick={() => addBox(col.id)}
                      className="flex items-center gap-1 bg-white px-1.5 py-0.5 rounded border border-gray-200 shadow-sm hover:bg-yellow-50 transition-all"
                      title="Add new item"
                    >
                      <span className="font-medium text-xs text-gray-700">{col.name === 'Information Things' ? 'Info Things' : col.name}</span>
                      <Plus size={8} className="text-gray-600" />
                    </button>
                  </div>
                ) : (
                  <div className="flex items-center justify-center gap-1.5 flex-wrap">
                    {col.id !== 'qualities' && (
                      <div className="font-bold text-xs text-gray-800 mr-1">{col.name === 'Information Things' ? 'Info Things' : col.name}</div>
                    )}
                    {col.subsections.map((sub, subIdx) => (
                      <button
                        key={subIdx}
                        onClick={() => addBox(col.id, sub.y)}
                        className="flex items-center gap-1 bg-white px-1.5 py-0.5 rounded border border-gray-200 shadow-sm hover:bg-yellow-50 transition-all"
                        title="Add new item"
                      >
                        <span className="font-medium text-xs text-gray-700">{sub.name}</span>
                        <Plus size={8} className="text-gray-600" />
                      </button>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Canvas */}
      <div className="flex-1 overflow-auto flex flex-col">
        <div
          ref={canvasRef}
          className="relative flex-1 w-full bg-gradient-to-br from-gray-50 to-gray-100"
          style={{ minHeight: '600px' }}
          onMouseMove={handleMouseMove}
          onMouseUp={handleMouseUp}
          onClick={handleCanvasClick}
        >
          {/* Column separators */}
          {COLUMNS.map((col, colIdx) => {
            const leftPos = getColumnLeftPosition(colIdx);
            const rightEdge = leftPos + (col.widthPercent / 100) * (canvasRef.current?.offsetWidth || 1400);
            
            return (
              <React.Fragment key={col.id}>
                {colIdx < COLUMNS.length - 1 && (
                  <div
                    className="absolute top-0 border-r-2 border-gray-400"
                    style={{ left: `${rightEdge}px`, height: '100%' }}
                  />
                )}
                {col.subsections.length > 0 && col.subsections.slice(1).map((sub, idx) => (
                  <div
                    key={idx}
                    className="absolute border-t-2 border-gray-400"
                    style={{ 
                      top: `${sub.y}px`,
                      left: `${leftPos}px`,
                      width: `${(col.widthPercent / 100) * (canvasRef.current?.offsetWidth || 1400)}px`
                    }}
                  />
                ))}
              </React.Fragment>
            );
          })}

          {/* Relations */}
          <svg className="absolute top-0 left-0 w-full h-full pointer-events-none" style={{ zIndex: 1, overflow: 'visible' }}>
            {relations.map(rel => {
              const from = getBoxCenter(rel.from);
              const to = getBoxCenter(rel.to);
              const midX = (from.x + to.x) / 2;
              const midY = (from.y + to.y) / 2;
              
              const angle = Math.atan2(to.y - from.y, to.x - from.x);
              const arrowAngle = (angle * 180) / Math.PI;
              const textOffsetX = Math.sin(angle) * 30;
              const textOffsetY = -Math.cos(angle) * 30;
              
              return (
                <g key={rel.id}>
                  <line
                    x1={from.x}
                    y1={from.y}
                    x2={to.x}
                    y2={to.y}
                    stroke="#156082"
                    strokeWidth="2.5"
                    markerEnd="url(#arrowhead)"
                    className="drop-shadow-sm"
                  />
                  <polygon
                    points="0,-6 12,0 0,6"
                    fill="#156082"
                    transform={`translate(${midX}, ${midY}) rotate(${arrowAngle})`}
                    className="pointer-events-auto cursor-pointer drop-shadow-md"
                    onClick={(e) => {
                      e.stopPropagation();
                      setEditingRelation(rel.id);
                    }}
                  />
                  <rect
                    x={midX + textOffsetX - 50}
                    y={midY + textOffsetY - 12}
                    width="100"
                    height="24"
                    fill="white"
                    stroke="#156082"
                    strokeWidth="1.5"
                    rx="6"
                    className="pointer-events-auto cursor-pointer drop-shadow-md"
                    onClick={(e) => {
                      e.stopPropagation();
                      setEditingRelation(rel.id);
                    }}
                  />
                  <text
                    x={midX + textOffsetX}
                    y={midY + textOffsetY + 4}
                    textAnchor="middle"
                    fontSize="11"
                    fill="#156082"
                    fontWeight="600"
                    className="pointer-events-none"
                  >
                    {rel.label.length > 14 ? rel.label.substring(0, 14) + '...' : rel.label}
                  </text>
                </g>
              );
            })}
            <defs>
              <marker
                id="arrowhead"
                markerWidth="10"
                markerHeight="10"
                refX="9"
                refY="3"
                orient="auto"
              >
                <polygon points="0 0, 10 3, 0 6" fill="#156082" />
              </marker>
            </defs>
          </svg>

          {/* Boxes */}
          {boxes.map(box => (
            <div
              key={box.id}
              className={`absolute rounded-lg cursor-move transition-all duration-200 select-none ${
                selectedBox === box.id 
                  ? 'shadow-2xl scale-105 ring-2 ring-offset-2 ring-blue-500' 
                  : 'shadow-lg hover:shadow-xl hover:scale-102'
              } ${connectingFrom === box.id ? 'ring-2 ring-blue-500 ring-offset-2' : ''}`}
              style={{
                left: `${box.x}px`,
                top: `${box.y}px`,
                width: '140px',
                backgroundColor: '#FFC000',
                border: '1px solid #4B5563',
                zIndex: selectedBox === box.id ? 20 : 10
              }}
              onMouseDown={(e) => handleMouseDown(e, box)}
              onClick={(e) => {
                e.stopPropagation();
                if (connectingFrom) {
                  completeConnection(box.id);
                }
              }}
            >
              {box.headerColor && (
                <div
                  style={{
                    position: 'absolute',
                    left: 0,
                    top: 0,
                    bottom: 0,
                    width: '4px',
                    backgroundColor: box.headerColor,
                    borderTopLeftRadius: '0.5rem',
                    borderBottomLeftRadius: '0.5rem'
                  }}
                />
              )}
              
              <div className="relative p-1.5">
                {editingBox === box.id ? (
                  <div className="flex items-center gap-1">
                    <input
                      type="text"
                      defaultValue={box.label}
                      className="flex-1 px-1.5 py-0.5 text-xs border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
                      autoFocus
                      onBlur={(e) => updateBoxLabel(box.id, e.target.value)}
                      onKeyDown={(e) => {
                        if (e.key === 'Enter') updateBoxLabel(box.id, e.target.value);
                        if (e.key === 'Escape') setEditingBox(null);
                      }}
                      onClick={(e) => e.stopPropagation()}
                    />
                    <button
                      onClick={(e) => {
                        e.stopPropagation();
                        const input = e.target.parentElement.querySelector('input');
                        updateBoxLabel(box.id, input.value);
                      }}
                      className="p-0.5 bg-green-500 text-white rounded hover:bg-green-600"
                    >
                      <Check size={10} />
                    </button>
                  </div>
                ) : (
                  <div className="flex items-start justify-between gap-1">
                    <div className="flex-1">
                      <div
                        className="text-xs text-gray-800 cursor-text break-words leading-snug"
                        onDoubleClick={(e) => {
                          e.stopPropagation();
                          setEditingBox(box.id);
                        }}
                      >
                        {box.label}
                      </div>
                    </div>
                    <button
                      onClick={(e) => {
                        e.stopPropagation();
                        setEditingBox(box.id);
                      }}
                      className="p-0.5 text-gray-500 hover:text-gray-700 hover:bg-white rounded transition-colors flex-shrink-0"
                      title="Edit label"
                    >
                      <Edit3 size={10} />
                    </button>
                  </div>
                )}
                
                {selectedBox === box.id && (
                  <div className="space-y-1 mt-1.5">
                    {tableData.length > 0 && (
                      <select
                        value={box.headerTag || ''}
                        onChange={(e) => {
                          e.stopPropagation();
                          updateBoxHeaderTag(box.id, e.target.value);
                        }}
                        onMouseDown={(e) => e.stopPropagation()}
                        onClick={(e) => e.stopPropagation()}
                        className="w-full text-xs border-2 border-gray-400 rounded px-1.5 py-1 cursor-pointer bg-white font-semibold"
                      >
                        <option value="">🏷️ Tag Header...</option>
                        {tableData[0].map((header, idx) => (
                          <option key={idx} value={header}>
                            {header}
                          </option>
                        ))}
                      </select>
                    )}
                    <button
                      onClick={(e) => {
                        e.stopPropagation();
                        startConnection(box.id);
                      }}
                      className={`w-full flex items-center justify-center gap-1 text-xs font-medium px-1.5 py-1 rounded-lg transition-all ${
                        connectingFrom === box.id 
                          ? 'bg-blue-600 text-white' 
                          : 'bg-white text-blue-600 hover:bg-blue-50 border border-blue-200'
                      }`}
                      title="Create relation"
                    >
                      <MoveHorizontal size={10} />
                      {connectingFrom === box.id ? 'Cancel' : 'Link'}
                    </button>
                  </div>
                )}
              </div>
            </div>
          ))}

          {/* Edit Relation Modal */}
          {editingRelation && (
            <div className="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm flex items-center justify-center z-50"
              onClick={() => setEditingRelation(null)}>
              <div className="bg-white p-6 rounded-2xl shadow-2xl max-w-md w-full mx-4"
                onClick={(e) => e.stopPropagation()}>
                <h3 className="text-lg font-bold mb-4 text-gray-800 flex items-center gap-2">
                  <Edit3 size={20} className="text-blue-600" />
                  Edit Relation
                </h3>
                <input
                  type="text"
                  defaultValue={relations.find(r => r.id === editingRelation)?.label}
                  className="w-full px-4 py-2.5 border border-gray-300 rounded-lg mb-4 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  autoFocus
                  onKeyDown={(e) => {
                    if (e.key === 'Enter') {
                      updateRelationLabel(editingRelation, e.target.value);
                    }
                    if (e.key === 'Escape') {
                      setEditingRelation(null);
                    }
                  }}
                />
                <div className="flex gap-2">
                  <button
                    onClick={() => {
                      const input = document.querySelector('.fixed input');
                      updateRelationLabel(editingRelation, input.value);
                    }}
                    className="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-lg hover:from-blue-700 hover:to-blue-800 font-medium transition-all"
                  >
                    <Check size={16} />
                    Save
                  </button>
                  <button
                    onClick={() => deleteRelation(editingRelation)}
                    className="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-red-600 to-red-700 text-white rounded-lg hover:from-red-700 hover:to-red-800 font-medium transition-all"
                  >
                    Delete
                  </button>
                  <button
                    onClick={() => setEditingRelation(null)}
                    className="px-4 py-2.5 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 font-medium transition-all"
                  >
                    <X size={16} />
                  </button>
                </div>
              </div>
            </div>
          )}
        </div>

        {/* Tab Bar */}
        <div className="bg-white border-t border-gray-300 flex items-center gap-1 px-2 py-1 overflow-x-auto">
          {tabs.map((tab) => (
            <div
              key={tab.id}
              className={`group flex items-center gap-2 px-3 py-1.5 rounded-t-lg cursor-pointer transition-all ${
                activeTabId === tab.id 
                  ? 'bg-blue-100 border border-b-0 border-gray-300 font-semibold' 
                  : 'bg-gray-100 hover:bg-gray-200 border border-transparent'
              }`}
              onClick={() => setActiveTabId(tab.id)}
            >
              {editingTabId === tab.id ? (
                <input
                  type="text"
                  defaultValue={tab.name}
                  className="w-24 px-1 py-0.5 text-xs border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
                  autoFocus
                  onBlur={(e) => renameTab(tab.id, e.target.value)}
                  onKeyDown={(e) => {
                    if (e.key === 'Enter') renameTab(tab.id, e.target.value);
                    if (e.key === 'Escape') setEditingTabId(null);
                  }}
                  onClick={(e) => e.stopPropagation()}
                />
              ) : (
                <span 
                  className="text-xs"
                  onDoubleClick={(e) => {
                    e.stopPropagation();
                    setEditingTabId(tab.id);
                  }}
                >
                  {tab.name}
                </span>
              )}
              {tabs.length > 1 && (
                <button
                  onClick={(e) => deleteTab(tab.id, e)}
                  className="opacity-0 group-hover:opacity-100 p-0.5 hover:bg-red-100 rounded transition-all"
                  title="Delete tab"
                >
                  <X size={12} className="text-red-600" />
                </button>
              )}
            </div>
          ))}
          <button
            onClick={addTab}
            className="flex items-center gap-1 px-2 py-1 bg-green-100 hover:bg-green-200 rounded text-xs font-medium transition-all"
            title="Add new canvas"
          >
            <Plus size={12} />
            New Canvas
          </button>
        </div>
      </div>

      {/* Instructions Footer */}
      <div className="bg-gradient-to-r from-blue-50 to-indigo-50 border-t border-gray-200 px-4 py-3">
        <div className="flex items-center gap-2 text-xs text-gray-700">
          <span className="font-bold text-blue-600">Quick Guide:</span>
          <span>• Toggle table input for CSV data</span>
          <span>• Click <Plus size={12} className="inline" /> to add items</span>
          <span>• Drag boxes to reposition</span>
          <span>• Double-click tab/box to rename</span>
          <span>• Select box, click "Link", then target box for relations</span>
          <span>• Press Delete/Escape keys for actions</span>
        </div>
      </div>
    </div>
  );
};

export default OntologyCanvas;
